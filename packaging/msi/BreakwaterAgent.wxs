<?xml version="1.0" encoding="UTF-8"?>
<!--
  Breakwater Agent MSI — WiX v5 authoring.

  Build (windows-latest CI / local Windows with WiX v5):
    wix build -o breakwater-agent.msi \
      -d AgentExePath=path\to\breakwater-agent.exe \
      -d ProductVersion=0.0.1 \
      BreakwaterAgent.wxs

  Silent install with enrollment token:
    msiexec /i breakwater-agent.msi /qn BWTOKEN=BW1:host:port:fp:secret

  First service start reads the token from
  C:\ProgramData\Breakwater\pending-enroll.token (SecureDir-restricted)
  written by a deferred custom action, then enrolls.

  Unsigned for MVP (PLAN: signing arrives Phase 2). CI publishes SHA256.

  UNTESTED ON WINDOWS until first CI windows-latest run validates the toolchain
  and install/uninstall behaviour — see PROGRESS.md untested list.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Breakwater Backup Agent"
      Manufacturer="Breakwater"
      Version="$(var.ProductVersion)"
      UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
      Scope="perMachine"
      Compressed="yes">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!--
      Enrollment token (S4-F2):
      - Secure="yes" — may cross elevation boundary into deferred custom actions
      - Hidden="yes" — WiX v5 way to redact the value from msiexec verbose logs
        (Property/@Hidden). Do NOT author Id="MsiHiddenProperties" — WiX v5
        rejects that special property (WIX0070: use attributes on Property instead).
    -->
    <Property Id="BWTOKEN" Secure="yes" Hidden="yes" />

    <!-- Install dir -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Breakwater">
        <Directory Id="AgentDir" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <!-- State dir under CommonAppData (ProgramData) -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="BreakwaterData" Name="Breakwater" />
    </StandardDirectory>

    <ComponentGroup Id="AgentComponents" Directory="AgentDir">
      <Component Id="AgentExe" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <File Id="BreakwaterAgentExe"
              Source="$(var.AgentExePath)"
              Name="breakwater-agent.exe"
              KeyPath="yes" />

        <!--
          Windows service: SYSTEM, auto-start, delayed.
          ServiceConfig here is the native MSI table (WiX emits WIX1149: SDK docs
          say ServiceConfig "does not work as expected"). We keep DelayedAutoStart
          for the intended post-boot behavior and accept the warning for MVP;
          replacing with WixToolset.Util.wixext ServiceConfig is a later cleanup.
          Runtime delayed-auto-start still requires a real Windows install to prove.
        -->
        <ServiceInstall
            Id="BreakwaterAgentService"
            Name="BreakwaterAgent"
            DisplayName="Breakwater Backup Agent"
            Description="Breakwater backup agent — dials out to the Breakwater server, runs backup jobs."
            Type="ownProcess"
            Start="auto"
            Account="LocalSystem"
            ErrorControl="normal"
            Vital="yes"
            Interactive="no">
          <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
        </ServiceInstall>

        <ServiceControl
            Id="StartBreakwaterAgent"
            Name="BreakwaterAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>
    </ComponentGroup>

    <!--
      State directory. ACL: agent SecureDir() at first Open() restricts to
      SYSTEM/Administrators. Token at rest is written into this directory
      (pending-enroll.token), NOT world-readable HKLM (S4-F2).

      Window between CreateFolder and first service start (folder inherits
      default ACLs until SecureDir runs) is listed on the untested-on-Windows
      list — empty until token write / enroll.
    -->
    <ComponentGroup Id="DataComponents" Directory="BreakwaterData">
      <Component Id="DataDir" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
        <CreateFolder />
        <RegistryValue
            Root="HKLM"
            Key="Software\Breakwater\Agent"
            Name="StateDir"
            Type="string"
            Value="[BreakwaterData]"
            KeyPath="yes" />
        <!-- NOTE: PendingEnrollToken is NOT written to HKLM (S4-F2).
             Token is written to [BreakwaterData]pending-enroll.token by CA below. -->
      </Component>
    </ComponentGroup>

    <!--
      Write enrollment token into the SecureDir-bound state directory.
      Deferred + no impersonation → SYSTEM. MsiHiddenProperties redacts BWTOKEN
      from logs. UNTESTED ON WINDOWS until first MSI install.
    -->
    <CustomAction Id="WritePendingEnrollToken"
                  Directory="BreakwaterData"
                  ExeCommand="cmd.exe /c if not &quot;[BWTOKEN]&quot;==&quot;&quot; (echo|[BWTOKEN])&gt;pending-enroll.token"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="WritePendingEnrollToken" After="CreateFolders" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- Event log source registration via registry (no custom action for MVP). -->
    <ComponentGroup Id="EventLogComponents" Directory="AgentDir">
      <Component Id="EventLogSource" Guid="D4E5F6A7-B8C9-0123-DEF0-234567890123">
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\BreakwaterAgent">
          <RegistryValue Name="EventMessageFile" Type="expandable" Value="[AgentDir]breakwater-agent.exe" KeyPath="yes" />
          <RegistryValue Name="TypesSupported" Type="integer" Value="7" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Breakwater Agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
      <ComponentGroupRef Id="DataComponents" />
      <ComponentGroupRef Id="EventLogComponents" />
    </Feature>

    <!--
      Clean uninstall: ServiceControl removes the service; files under INSTALLDIR
      and state under ProgramData are removed with components. Server-side backups
      are never touched.

      Enroll-then-persist recovery (S4-F5): if the Enroll RPC succeeds but the
      agent cannot write identity files, the single-use token is already burned
      and the machine row exists. Recovery: admin removes the stale machine row,
      mints a fresh BW1 token, and reinstalls/re-runs with a new agent keypair
      (same cert cannot re-enroll — already-enrolled).
    -->
  </Package>
</Wix>
